# Nested overrides use LUZIFER_<SECTION>__<KEY>
# Example: LUZIFER_OSC__PORT=9000

LUZIFER_OSC__HOST=127.0.0.1
LUZIFER_OSC__PORT=9000

LUZIFER_DASHBOARD__HOST=127.0.0.1
LUZIFER_DASHBOARD__PORT=8501

LUZIFER_LLM__BASE_URL=http://127.0.0.1:11434
LUZIFER_LLM__MODEL=llama3.2

